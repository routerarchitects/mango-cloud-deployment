# ==============================================================================
# HTTP server
# ==============================================================================

HTTP_PORT=8088
PRIVATE_HTTP_PORT=17007

INTERNAL_RESTAPI_HOST_CERT=/app/certs/restapi-cert.pem
INTERNAL_RESTAPI_HOST_KEY=/app/certs/restapi-key.pem
INTERNAL_RESTAPI_HOST_ROOTCA=/app/certs/restapi-ca.pem


# ==============================================================================
# Service identity
# ==============================================================================

SERVICE_NAME=nwtopology
SERVICE_VERSION=1.0.0
SERVICE_TYPE=nwtopology
ENVIRONMENT=dev


# ==============================================================================
# Logging
# ==============================================================================

LOG_FORMAT=json
LOG_ADD_SOURCE=false
LOG_LEVEL=info
LOG_SUBSYSTEM_LEVELS=

LOG_REDACT_ENABLED=true
LOG_REDACT_KEYS=authorization,cookie,set-cookie,password,passwd,token,access_token,refresh_token,secret,api_key,x-api-key
LOG_REDACT_REPLACEMENT=******

LOG_STACK_ENABLED=true
LOG_STACK_LEVEL=error


# ==============================================================================
# Kafka
# ==============================================================================

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=nwtopology-service

KAFKA_CONSUMER_GROUP_ID=nwtopology-service-group
KAFKA_CONSUMER_INITIAL_OFFSET=newest
KAFKA_CONSUMER_SESSION_TIMEOUT=10s
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=1s
KAFKA_CONSUMER_MAX_PROCESSING_TIME=30s
KAFKA_CONSUMER_COMMIT_INTERVAL=5s

KAFKA_PRODUCER_MAX_MESSAGE_BYTES=1000000
KAFKA_PRODUCER_REQUIRED_ACKS=-1
KAFKA_PRODUCER_TIMEOUT=5s
KAFKA_PRODUCER_COMPRESSION=snappy
KAFKA_PRODUCER_IDEMPOTENT=true
KAFKA_PRODUCER_MAX_RETRIES=3
KAFKA_PRODUCER_RETRY_BACKOFF=100ms

KAFKA_AUTH_SASL_ENABLED=false
KAFKA_AUTH_TLS_ENABLED=false


# ==============================================================================
# Service discovery
# ==============================================================================

DISCOVERY_TOPIC=service_events
DISCOVERY_ORDERING=round-robin
DISCOVERY_KEEPALIVE_INTERVAL=10s
DISCOVERY_EXPIRY_MULTIPLIER=2
DISCOVERY_SWEEP_INTERVAL=5s

SYSTEM_INSTANCE_KEY=changeme

SYSTEM_URI_PRIVATE=https://nwtopology.wlan.local:17007
SYSTEM_URI_PUBLIC=https://openwifi.wlan.local:16007
SYSTEM_URI_UI=https://openwifi.wlan.local